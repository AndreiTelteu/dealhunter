# Production Environment Configuration
# Copy this file to .env.production and update the values

APP_NAME="OLX Deal Hunter"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Bucharest
APP_URL=https://your-domain.com
APP_VERSION=1.0.0

# Logging Configuration
LOG_CHANNEL=production
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=olx_deal_hunter
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=your_secure_redis_password
REDIS_PORT=6379

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=olx_deal_hunter

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIES=true

# Queue Configuration
QUEUE_CONNECTION=redis

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# MCP Configuration
MCP_PLAYWRIGHT_ENDPOINT=http://playwright-mcp:3000
MCP_PLAYWRIGHT_TOKEN=your_mcp_token_here

# Crawler Configuration
CRAWLER_ENABLED=false
# Comma-separated Europe/Bucharest windows; empty permits any time.
CRAWLER_ALLOWED_WINDOWS=08:00-20:00
CRAWLER_TIMEZONE=Europe/Bucharest
# Set true only after reviewing the target site's applicable terms and permissions.
CRAWLER_TERMS_ACKNOWLEDGED=false
CRAWLER_MAX_PAGES_PER_SEARCH=3
CRAWLER_REQUEST_DELAY_MS=2000
CRAWLER_MAX_LISTINGS_PER_RUN=100
CRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Currency Configuration
DEFAULT_CURRENCY=RON
EUR_TO_RON_RATE=4.95
USD_TO_RON_RATE=4.50

# AI Classification Configuration
AI_CLASSIFICATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.7
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your_openai_api_key_here

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST_LIMIT=10

# Security Configuration
BCRYPT_ROUNDS=12

# Demo User Configuration
DEMO_PASSWORD=your_secure_demo_password

# Monitoring Configuration (optional)
GRAFANA_PASSWORD=your_secure_grafana_password

# Feature Flags
DETAIL_PAGE_CRAWLING=false
IMAGE_URL_EXTRACTION=true
SELLER_INFO_EXTRACTION=true
