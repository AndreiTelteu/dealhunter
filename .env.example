APP_NAME="OLX Deal Hunter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=olx_deal_hunter
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MCP Configuration
# Complete Streamable HTTP MCP URL. Do not append another /mcp path.
MCP_PLAYWRIGHT_ENDPOINT=http://localhost:3000/mcp
# Leave blank when the server does not require authentication.
MCP_PLAYWRIGHT_TOKEN=
MCP_INIT_TIMEOUT_MS=10000
MCP_SSE_READ_TIMEOUT_MS=30000
MCP_SESSION_AUTO_RECOVER=true
MCP_PROTOCOL_VERSION=2025-06-18

# Crawler Configuration
CRAWLER_ENABLED=false
# Comma-separated Europe/Bucharest windows; empty permits any time.
CRAWLER_ALLOWED_WINDOWS=08:00-20:00
CRAWLER_TIMEZONE=Europe/Bucharest
# Set true only after reviewing the target site's applicable terms and permissions.
CRAWLER_TERMS_ACKNOWLEDGED=false
CRAWLER_MAX_PAGES_PER_SEARCH=3
CRAWLER_REQUEST_DELAY_MS=2000
CRAWLER_MAX_LISTINGS_PER_RUN=100
CRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# Currency Configuration
DEFAULT_CURRENCY=RON
EUR_TO_RON_RATE=4.95
USD_TO_RON_RATE=4.50

# AI Classification
AI_CLASSIFICATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.7
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your_api_key_here

# Alternative AI providers:
# For Anthropic Claude:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-haiku-20240307
# AI_API_KEY=your_anthropic_api_key

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST_LIMIT=10
